PUID=1000
PGID=1000
# LAN address of Ubuntu mini PC. 127.0.0.1 only permits local access / SSH tunnel.
BIND_IP=127.0.0.1
DATA_DIR=./data
QBIT_USERNAME=admin
QBIT_PASSWORD=replace-me
JELLYFIN_USERNAME=replace-me
JELLYFIN_API_KEY=replace-me
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_OWNER_ID=123456789
DELETE_GRACE_SECONDS=120

# Jackett dashboard generates this key; keep it local.
JACKETT_API_KEY=replace-me

COMPOSE_PROJECT_NAME=watchnext
QBIT_PORT=8080
JELLYFIN_PORT=8096
JACKETT_PORT=9117
TORRENT_PORT=6881
# Pick an unused Docker subnet; installer detects conflicts.
SEARCH_DNS_SUBNET=172.30.53.0/24
SEARCH_DNS_IP=172.30.53.2
